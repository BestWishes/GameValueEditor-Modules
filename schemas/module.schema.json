{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BestWishes/GameValueEditor-Modules/schemas/module.schema.json",
  "title": "GameValueEditor module manifest",
  "type": "object",
  "required": ["id", "version", "displayName", "gameDisplayName", "description", "assemblyFile", "hostApiVersion", "processNames", "compatibleBuilds", "editors"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^game\\.[a-z0-9.-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "gameDisplayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "legacyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^game\\.[a-z0-9.-]+$" }
    },
    "assemblyFile": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" },
    "hostApiVersion": { "type": "integer", "minimum": 2, "maximum": 4 },
    "processNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "compatibleBuilds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executableSha256", "gameAssemblySha256", "metadataSha256"],
        "properties": {
          "executableSha256": { "$ref": "#/$defs/sha256" },
          "gameAssemblySha256": { "$ref": "#/$defs/sha256" },
          "metadataSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "editors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "kind", "order", "sessionOnly"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["collection", "master-detail", "property-grid"] },
          "order": { "type": "integer" },
          "sessionOnly": { "type": "boolean" }
        }
      }
    },
    "contributors": {
      "type": "array",
      "items": { "$ref": "#/$defs/contributor" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^(?!0{64}$)[A-Fa-f0-9]{64}$" },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubId", "githubLogin", "displayName", "profileUrl", "firstContributionDate", "latestContributionDate"],
      "properties": {
        "githubId": { "type": "integer", "minimum": 1 },
        "githubLogin": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "profileUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/?$" },
        "firstContributionDate": { "type": "string", "format": "date" },
        "latestContributionDate": { "type": "string", "format": "date" }
      }
    }
  }
}
