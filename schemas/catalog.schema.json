{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BestWishes/GameValueEditor-Modules/schemas/catalog.schema.json",
  "title": "GameValueEditor public module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostApiVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "hostApiVersion": { "const": 6 },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^(?!0{64}$)[A-Fa-f0-9]{64}$" },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "order", "sessionOnly"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["collection", "master-detail", "property-grid"] },
        "order": { "type": "integer" },
        "sessionOnly": { "type": "boolean" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executableSha256", "gameAssemblySha256", "metadataSha256"],
      "properties": {
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "gameAssemblySha256": { "$ref": "#/$defs/sha256" },
        "metadataSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubId", "githubLogin", "displayName", "profileUrl", "firstContributionDate", "latestContributionDate"],
      "properties": {
        "githubId": { "type": "integer", "minimum": 1 },
        "githubLogin": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "profileUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/?$" },
        "firstContributionDate": { "type": "string", "format": "date" },
        "latestContributionDate": { "type": "string", "format": "date" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hostApiVersion", "minimumHostVersion", "compatibleBuilds", "editors", "downloadUrl", "sizeBytes", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$" },
        "hostApiVersion": { "type": "integer", "minimum": 2, "maximum": 7 },
        "minimumHostVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$" },
        "maximumHostVersion": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$"
        },
        "compatibleBuilds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build" }
        },
        "editors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/editor" }
        },
        "downloadUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/BestWishes/GameValueEditor-Modules/releases/download/[^/]+/[^/]+\\.zip$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName", "gameDisplayName", "description", "hostApiVersion", "minimumHostVersion", "processNames", "compatibleBuilds", "editors", "contributors", "downloadUrl", "sizeBytes", "sha256", "releases"],
      "properties": {
        "id": { "type": "string", "pattern": "^game\\.[a-z0-9.-]+$" },
        "legacyIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^game\\.[a-z0-9.-]+$" }
        },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$" },
        "displayName": { "type": "string", "minLength": 1 },
        "gameDisplayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "hostApiVersion": { "type": "integer", "minimum": 2, "maximum": 7 },
        "minimumHostVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$" },
        "maximumHostVersion": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$"
        },
        "processNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "compatibleBuilds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build" }
        },
        "editors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/editor" }
        },
        "contributors": {
          "type": "array",
          "items": { "$ref": "#/$defs/contributor" }
        },
        "downloadUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/BestWishes/GameValueEditor-Modules/releases/download/[^/]+/[^/]+\\.zip$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "releases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/release" }
        }
      }
    }
  }
}
