<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameValueEditor.Modules.Fzzml</AssemblyName>
    <RootNamespace>GameValueEditor.Modules.Fzzml</RootNamespace>
    <ModuleVersion Condition="'$(ModuleVersion)' == ''">2.1.1</ModuleVersion>
    <Version>$(ModuleVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\GameValueEditor.ModuleSdk\GameValueEditor.ModuleSdk.csproj" Private="false" />
    <Compile Include="..\..\shared\ModuleEditorPages.cs" Link="src\Shared\ModuleEditorPages.cs" />
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
